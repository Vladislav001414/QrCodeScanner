<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Это цвет самой линии рамки (границы квадрата) -->

    <!-- Скругление углов нашего квадрата -->
    <corners android:radius="16dp" />

    <!-- ГЛАВНЫЙ ТРЮК: Задаем огромный внутренний отступ (padding).
         Android сожмет внутреннюю часть, превратив ее в квадрат,
         а всё пространство вокруг зальет полупрозрачным цветом. -->
    <padding
        android:bottom="140dp"
        android:left="60dp"
        android:right="60dp"
        android:top="140dp" />

    <!-- Полупрозрачный черный цвет для затемнения экрана вокруг квадрата -->
    <solid android:color="#99000000" />
</shape>
